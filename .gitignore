**/target/

# AI-tooling working files stay local, consistent with the sibling portfolio repos
.claude/
CLAUDE.md
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/eclipse-java-formatter.xml
node_modules/
org/

# Python bytecode (e.g. from the diagnosis skill's scripts)
__pycache__/
*.pyc

docs/superpowers/
docs/*-code-eval-*.md

# Environment files — never commit credentials
.env
.env.*
*.local
!.env.example
flink/**/*.class

# JMeter: vendored runtime and per-run results are local artifacts
jmeter/.runtime/
jmeter/results/

infra/prometheus/targets/
temp/
