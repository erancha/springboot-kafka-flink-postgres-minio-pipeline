{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "title": "userKeys Pipeline Health",
  "uid": "userkeys-pipeline-health",
  "tags": [
    "flink",
    "operability",
    "pipeline",
    "pipeline_userkeys"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health — is the pipeline OK at 3am?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Flink scrape targets up",
      "description": "Flink metrics endpoints being scraped (JobManager + TaskManager). Below the full count means the panels below are going blind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"flink\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Job restarts (per window)",
      "description": "Should be flat 0. A step up = the job restarted then; line it up against a load spike or checkpoint failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(increase(flink_jobmanager_job_numRestarts{job_name=\"Kafka__Flink__Postgres__userKeys_\"}[$__rate_interval]))",
          "legendFormat": "restarts"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Failed checkpoints (per window)",
      "description": "Should be flat 0 (the one-time startup abort doesn't show here). A step up = checkpoints failing now, so the job can't commit progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(increase(flink_jobmanager_job_numberOfFailedCheckpoints{job_name=\"Kafka__Flink__Postgres__userKeys_\"}[$__rate_interval]))",
          "legendFormat": "failed checkpoints"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Last checkpoint duration",
      "description": "Time for the latest checkpoint (interval 10s, timeout 60s). Flat and low is healthy; climbing toward 60s — panel turns orange at 30s, red at 55s — means a slow write path or backpressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30000
              },
              {
                "color": "red",
                "value": 55000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_lastCheckpointDuration{job_name=\"Kafka__Flink__Postgres__userKeys_\"})",
          "legendFormat": "last checkpoint duration"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Last checkpoint size",
      "description": "State is one running sum per open (user, key) window, so size = keys in flight. Healthy rises and falls as windows fire; a climb that never drops back = unbounded key growth (a state leak).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_lastCheckpointSize{job_name=\"Kafka__Flink__Postgres__userKeys_\"})",
          "legendFormat": "last checkpoint size"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka consumer lag — committed (Kafka) vs pending (Flink)",
      "description": "Committed lag (Kafka) is the signal: records past the offset Flink has durably committed. Flink commits only on checkpoint, so it sawtooths, dropping every ~10s; tens of thousands under load is fine while it keeps falling back. Trouble is a floor that climbs and never recovers (falling behind). Pending records (Flink) is Flink's own count of un-read Kafka backlog — usually 0 in this deployment, so ignore it unless it holds a large value.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"flink-userkeys-processor\",topic=\"user-keys\"})",
          "legendFormat": "committed lag (Kafka)"
        },
        {
          "refId": "B",
          "expr": "sum(flink_taskmanager_job_task_operator_pendingRecords{job_name=\"Kafka__Flink__Postgres__userKeys_\"})",
          "legendFormat": "pending records (Flink)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DLQ records / sec by stage",
      "description": "Should be flat 0. Only the parse stage dead-letters here, so expect a single PARSE series. Sink-side failures don't show here — they surface as failed checkpoints and a restart loop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(flink_taskmanager_job_task_operator_stage_dlq_records{job_name=\"Kafka__Flink__Postgres__userKeys_\"}[5m]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Backpressure & busy time (ms/s per task)",
      "description": "Per task, ms/s. Busy is normal work. Backpressure climbing toward 1000 (fully blocked) = the Postgres sink can't keep up and is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(flink_taskmanager_job_task_backPressuredTimeMsPerSecond{job_name=\"Kafka__Flink__Postgres__userKeys_\"})",
          "legendFormat": "backpressured"
        },
        {
          "refId": "B",
          "expr": "avg(flink_taskmanager_job_task_busyTimeMsPerSecond{job_name=\"Kafka__Flink__Postgres__userKeys_\"})",
          "legendFormat": "busy"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Throughput & performance — workload shape, not paging signals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Kafka consumer lag — committed (Kafka) vs pending (Flink)",
      "description": "Committed lag climbing while records/sec stays flat = the pipeline, not the inbound rate, is the bottleneck.\n\n(Same lag pair as the Health row, placed beside records/sec to read lag against throughput; full meaning lives there.)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"flink-userkeys-processor\",topic=\"user-keys\"})",
          "legendFormat": "committed lag (Kafka)"
        },
        {
          "refId": "B",
          "expr": "sum(flink_taskmanager_job_task_operator_pendingRecords{job_name=\"Kafka__Flink__Postgres__userKeys_\"})",
          "legendFormat": "pending records (Flink)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Aggregate rows written / sec",
      "description": "Window-result rows to Postgres/sec — one per closed (user, key) 60s window, so this is the window-firing rate, not inbound events. Lands in checkpoint-sized batches. A drop to 0 while events keep arriving = windows not firing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsIn{job_name=\"Kafka__Flink__Postgres__userKeys_\",operator_name=\"user_key_agg_to_postgres:_Writer\"}[5m]))",
          "legendFormat": "aggregate rows/sec"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Aggregate rows written — cumulative",
      "description": "Lifetime window-result rows written to Postgres. Resets to 0 on a job restart (expected).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(flink_taskmanager_job_task_operator_numRecordsIn{job_name=\"Kafka__Flink__Postgres__userKeys_\",operator_name=\"user_key_agg_to_postgres:_Writer\"})",
          "legendFormat": "aggregate rows"
        }
      ]
    }
  ]
}