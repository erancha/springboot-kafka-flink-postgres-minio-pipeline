{
  "uid": "processed-events",
  "title": "Processed Events Analytics",
  "tags": [
    "webcharm",
    "assignment"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "📊 This dashboard reads only the Flink **pre-aggregated** tables (`event_type_counts_agg`, `image_size_buckets_agg`), which hold one row per closed window and stay small regardless of how much data is ingested — so these queries stay cheap as the pipeline scales. For live (15s) pipeline metrics, use the **Pipeline Health** dashboard, which queries Prometheus."
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Events per 5m window (Flink pre-aggregated)",
      "gridPos": {
        "h": 18,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT window_start AS time,\n       event_count::bigint AS value,\n       event_type AS metric\nFROM event_type_counts_agg\nWHERE $__timeFilter(window_start)\nORDER BY window_start;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Stored images by size bucket (Flink pre-aggregated)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT bucket,\n       SUM(image_count)::bigint AS count\nFROM image_size_buckets_agg\nGROUP BY bucket\nORDER BY CASE bucket WHEN '<=1MB' THEN 1 WHEN '<=5MB' THEN 2 WHEN '<=10MB' THEN 3 ELSE 4 END;"
        }
      ],
      "options": {
        "xField": "bucket",
        "yField": "count",
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Image size buckets per 10m window (Flink pre-aggregated)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT window_start AS time,\n       image_count::bigint AS value,\n       bucket AS metric\nFROM image_size_buckets_agg\nWHERE $__timeFilter(window_start)\nORDER BY window_start;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
