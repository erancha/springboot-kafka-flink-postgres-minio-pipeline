{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "title": "eventtype Pipeline Health",
  "uid": "pipeline-health",
  "tags": [
    "flink",
    "operability",
    "pipeline",
    "pipeline_eventtype"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health — is the pipeline OK at 3am?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Flink scrape targets up",
      "description": "Flink metrics endpoints being scraped (JobManager + TaskManager). Below the full count means the panels below are going blind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"flink\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Job restarts (per window)",
      "description": "Should be flat 0. A step up = the job restarted then; line it up against a load spike or checkpoint failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(increase(flink_jobmanager_job_numRestarts[$__rate_interval]))",
          "legendFormat": "restarts"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Failed checkpoints (per window)",
      "description": "Should be flat 0 (the one-time startup abort doesn't show here). A step up = checkpoints failing now, so the job can't commit progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(increase(flink_jobmanager_job_numberOfFailedCheckpoints[$__rate_interval]))",
          "legendFormat": "failed checkpoints"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Last checkpoint duration",
      "description": "Time for the latest checkpoint (interval 10s, timeout 60s). Flat and low is healthy; climbing toward 60s — panel turns orange at 30s, red at 55s — means a slow write path or backpressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30000
              },
              {
                "color": "red",
                "value": 55000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_lastCheckpointDuration)",
          "legendFormat": "last checkpoint duration"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka consumer lag — committed (Kafka) vs pending (Flink)",
      "description": "Committed lag (Kafka) is the signal: records past the offset Flink has durably committed. Flink commits only on checkpoint, so it sawtooths, dropping every ~10s; tens of thousands under load is fine while it keeps falling back. Trouble is a floor that climbs and never recovers (falling behind). Pending records (Flink) is Flink's own count of un-read Kafka backlog — usually 0 in this deployment, so ignore it unless it holds a large value.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"flink-processor\",topic=\"events\"})",
          "legendFormat": "committed lag (Kafka)"
        },
        {
          "refId": "B",
          "expr": "sum(flink_taskmanager_job_task_operator_pendingRecords)",
          "legendFormat": "pending records (Flink)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DLQ records / sec by stage",
      "description": "Should be flat 0. A sustained series = records being dead-lettered at that stage (parse, image-enrich, image-write, data-write, type-count-write) — bad input or a failing stage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(flink_taskmanager_job_task_operator_stage_dlq_records[5m]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retryable enrichment failures / sec",
      "description": "Near zero is healthy. Sustained values = the IMAGE branch retrying transient URL-fetch or MinIO-upload errors — a slow or flaky upstream.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_image_retryable_failures[5m]))",
          "legendFormat": "retryable failures"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Backpressure & busy time (ms/s per task)",
      "description": "Per task, ms/s. Busy is normal work. Backpressure climbing toward 1000 (fully blocked) = a downstream operator can't keep up and is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(flink_taskmanager_job_task_backPressuredTimeMsPerSecond)",
          "legendFormat": "backpressured"
        },
        {
          "refId": "B",
          "expr": "avg(flink_taskmanager_job_task_busyTimeMsPerSecond)",
          "legendFormat": "busy"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Throughput & performance — workload shape, not paging signals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Kafka consumer lag — committed (Kafka) vs pending (Flink)",
      "description": "Committed lag climbing while events/sec stays flat = the pipeline, not the inbound rate, is the bottleneck.\n\n(Same lag pair as the Health row, placed above events/sec to read lag against throughput; full meaning lives there.)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"flink-processor\",topic=\"events\"})",
          "legendFormat": "committed lag (Kafka)"
        },
        {
          "refId": "B",
          "expr": "sum(flink_taskmanager_job_task_operator_pendingRecords)",
          "legendFormat": "pending records (Flink)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Average MinIO upload time (ms)",
      "description": "Per-image upload time to MinIO. Low and stable is healthy; a rising line means MinIO or the network is slowing the IMAGE path. Successful uploads only.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(flink_taskmanager_job_task_operator_minio_upload_nanos[5m])) / sum(rate(flink_taskmanager_job_task_operator_minio_uploads[5m]))) / 1e6",
          "legendFormat": "avg upload time"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Events / sec into Postgres by type (DATA vs IMAGE)",
      "description": "Postgres write rate, DATA vs enriched IMAGE — the live event-type mix. Failed writes still count here; the Health-row DLQ panel shows the failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operator_name) (rate(flink_taskmanager_job_task_operator_numRecordsIn{operator_name=~\"data_to_postgres|image_to_postgres\"}[5m]))",
          "legendFormat": "{{operator_name}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "MinIO uploads / sec",
      "description": "Successful image uploads/sec. Sits below the IMAGE event rate — idempotent re-hits and passthrough images skip the upload.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_minio_uploads[5m]))",
          "legendFormat": "uploads/sec"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cumulative events processed by type",
      "description": "Lifetime Postgres writes per path (DATA vs IMAGE). Resets to 0 on a job restart (expected).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-pipeline"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operator_name) (flink_taskmanager_job_task_operator_numRecordsIn{operator_name=~\"data_to_postgres|image_to_postgres\"})",
          "legendFormat": "{{operator_name}}"
        }
      ]
    }
  ]
}