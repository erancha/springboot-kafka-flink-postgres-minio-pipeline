# ============================================================
# CONFIGURATION
# ============================================================

# --- Kafka ---
KAFKA_HOST=
KAFKA_HOST_LOCAL=
KAFKA_PORT=
KAFKA_TOPIC=
KAFKA_DLQ_TOPIC=   # must match ${KAFKA_TOPIC}-dlq

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_HOST_LOCAL=
POSTGRES_PORT=
POSTGRES_DB=

# --- MinIO ---
MINIO_HOST=
MINIO_HOST_LOCAL=
MINIO_PORT=
MINIO_CONSOLE_PORT=
MINIO_BUCKET=

# --- Backend ---
# Comma-separated SSRF allowlist of hosts permitted for URL-based IMAGE events.
# Empty denies all imageUrl submissions (403); set e.g. www.gstatic.com to enable the URL image path.
IMAGE_URL_ALLOWED_HOSTS=

# --- Exposed host ports ---
BACKEND_PORT=
UI_PORT=
GRAFANA_PORT=
KAFKA_UI_PORT=8088
MINIO_PORT_EXPOSED=
MINIO_CONSOLE_PORT_EXPOSED=

# ============================================================
# SECRETS  (migrate to Vault / AWS Secrets Manager before prod)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Grafana ---
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
