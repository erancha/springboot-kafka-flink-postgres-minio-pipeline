# ============================================================
# CONFIGURATION
# ============================================================

# --- Kafka ---
KAFKA_HOST=
KAFKA_HOST_LOCAL=
KAFKA_PORT=
KAFKA_TOPIC=
KAFKA_DLQ_TOPIC=   # must match ${KAFKA_TOPIC}-dlq

# Couples events-topic partitions, Flink slots, and job -p (mind POSTGRES_MAX_CONNECTIONS).
PIPELINE_PARALLELISM=8

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_HOST_LOCAL=
POSTGRES_PORT=
POSTGRES_DB=

# Must exceed ~4 × PIPELINE_PARALLELISM (Flink sink connections).
POSTGRES_MAX_CONNECTIONS=100

# Flink TaskManager memory: container cap and Flink's process.size in one (kept equal).
FLINK_TM_MEMORY=2048m

# --- MinIO ---
MINIO_HOST=
MINIO_HOST_LOCAL=
MINIO_PORT=
MINIO_CONSOLE_PORT=
MINIO_BUCKET=

# --- Backend ---
# Comma-separated SSRF allowlist of hosts permitted for URL-based IMAGE events.
# Empty denies all imageUrl submissions (403); set e.g. www.gstatic.com to enable the URL image path.
IMAGE_URL_ALLOWED_HOSTS=

# Max /api request body bytes; empty disables.
MAX_REQUEST_CONTENT_LENGTH=

# JSON Schema location for DATA payloads; empty disables.
EVENT_PAYLOAD_SCHEMA=classpath:event-payload-schema.json

# Backend default log level; empty defaults to INFO.
# LOG_LEVEL=DEBUG

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=''
EMAIL_TO=

# Host name shown in Flink alerts. Defaults to the OS hostname; set to override.
# MACHINE_NAME=

# --- Exposed host ports ---
BACKEND_PORT=
UI_PORT=
GRAFANA_PORT=
PROMETHEUS_PORT=9090
KAFKA_UI_PORT=8088
MINIO_PORT_EXPOSED=
MINIO_CONSOLE_PORT_EXPOSED=

# ============================================================
# SECRETS  (migrate to Vault / AWS Secrets Manager before prod)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Grafana ---
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
